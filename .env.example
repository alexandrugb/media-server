# Reference for every variable used across the stacks.
# Copy the relevant lines into a .env file inside each stack directory.

# Shared external docker network (create with: docker network create media)
DOCKER_NETWORK=media

# Ownership and timezone applied to every linuxserver.io container
PUID=1000
PGID=1000
TZ=Europe/Bucharest

# Persistent application configuration, one subdirectory per service
CONFIG_ROOT=/home/alexandrung/docker/config

# Single media root shared by every service so hardlinks and atomic moves work.
# Expected layout:
#   ${DATA_ROOT}/torrents/movies
#   ${DATA_ROOT}/torrents/tv
#   ${DATA_ROOT}/media/movies
#   ${DATA_ROOT}/media/tv
DATA_ROOT=/mnt/media

# Plex
PLEX_CLAIM=
PLEX_HOSTNAME=fedora-media

# Cloudflare tunnel
TUNNEL_TOKEN=

# Monitoring
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Address the admin web UIs publish on. Leave empty to listen on all
# interfaces, which gives you both LAN and Tailscale access. Set it to a
# single IP (e.g. this host's Tailscale IP from `tailscale ip -4`) if you
# ever want to hide the UIs from the LAN.
BIND_ADDR=0.0.0.0
