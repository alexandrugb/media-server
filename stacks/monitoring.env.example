# Paste these into the Environment box of the Komodo "monitoring" Stack.

DOCKER_NETWORK=media
TZ=Europe/Bucharest

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Settings > General in each app
RADARR_API_KEY=
SONARR_API_KEY=
PROWLARR_API_KEY=

# Discord channel > Edit Channel > Integrations > Webhooks > New Webhook
DISCORD_WEBHOOK_URL=

# Address the admin web UIs publish on. Leave empty to listen on all
# interfaces, which gives you both LAN and Tailscale access. Set it to a
# single IP (e.g. this host's Tailscale IP from `tailscale ip -4`) if you
# ever want to hide the UIs from the LAN.
BIND_ADDR=0.0.0.0
