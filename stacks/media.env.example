# Paste these into the Environment box of the Komodo "media" Stack.

DOCKER_NETWORK=media

PUID=1000
PGID=1000
TZ=Europe/Bucharest

CONFIG_ROOT=/home/alexandrung/docker/config
DATA_ROOT=/mnt/media

# Fresh token from https://plex.tv/claim (valid 4 minutes, one-time use)
PLEX_CLAIM=
PLEX_HOSTNAME=fedora-media

# Tunnel token from the Cloudflare Zero Trust dashboard
TUNNEL_TOKEN=

# Address the admin web UIs publish on. Leave empty to listen on all
# interfaces, which gives you both LAN and Tailscale access. Set it to a
# single IP (e.g. this host's Tailscale IP from `tailscale ip -4`) if you
# ever want to hide the UIs from the LAN.
BIND_ADDR=0.0.0.0
